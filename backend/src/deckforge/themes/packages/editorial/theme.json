{
  "name": "editorial",
  "label": "Editorial",
  "description": "Magazine layout language: strong rules, big pull quotes.",
  "tags": [
    "editorial",
    "magazine",
    "story",
    "light",
    "serif"
  ],
  "mode": "light",
  "version": "1.0.0",
  "author": "DeckForge",
  "palette": {
    "background": "#ffffff",
    "surface": "#f4f4f2",
    "surface_alt": "#e9e9e5",
    "text": "#101010",
    "text_muted": "#5d5d5d",
    "primary": "#d7263d",
    "secondary": "#1b1b1b",
    "accent": "#f4a261",
    "border": "#dededa"
  },
  "fonts": {
    "heading": "Playfair Display",
    "body": "Inter",
    "office_heading": "Georgia",
    "office_body": "Calibri",
    "fallback": "Georgia, serif"
  },
  "type_scale": {
    "display": {
      "size": 78,
      "weight": 700,
      "letter_spacing": -1.8
    },
    "title": {
      "size": 46,
      "weight": 700
    },
    "eyebrow": {
      "letter_spacing": 2.6,
      "color": "primary"
    },
    "quote": {
      "size": 40,
      "font": "heading",
      "weight": 600
    }
  },
  "shape": {
    "radius": 0,
    "card_radius": 0,
    "image_radius": 0,
    "shadow": "none",
    "card_border": true
  },
  "bullets": {
    "marker": "dash"
  },
  "icon_style": "outline",
  "background": {
    "kind": "solid",
    "color": "#ffffff"
  },
  "decor": {
    "default": {
      "kind": "underline",
      "color": "primary",
      "opacity": 1.0,
      "size": 4
    }
  },
  "layout_preferences": {
    "cover": [
      "hero",
      "image_background"
    ],
    "agenda": [
      "agenda",
      "two_column",
      "cards"
    ],
    "section": [
      "section_divider",
      "section_number",
      "big_statement"
    ],
    "content": [
      "two_column",
      "bullets",
      "image_right",
      "split"
    ],
    "comparison": [
      "comparison",
      "two_column",
      "table"
    ],
    "timeline": [
      "timeline",
      "process"
    ],
    "roadmap": [
      "roadmap",
      "timeline"
    ],
    "process": [
      "process",
      "flow",
      "cycle"
    ],
    "metrics": [
      "metrics",
      "dashboard"
    ],
    "chart": [
      "chart_focus",
      "dashboard",
      "split"
    ],
    "diagram": [
      "diagram",
      "architecture",
      "flow"
    ],
    "table": [
      "table"
    ],
    "image": [
      "image_full",
      "image_left",
      "image_right"
    ],
    "quote": [
      "quote"
    ],
    "quiz": [
      "quiz",
      "cards"
    ],
    "references": [
      "references",
      "two_column"
    ],
    "appendix": [
      "bullets",
      "table"
    ],
    "ending": [
      "ending",
      "hero_centered"
    ]
  }
}
