# ---------------------------------------------------------------------------
# DeckForge configuration. Copy to `.env` and edit.
# Everything has a working default: with Ollama running you need no changes.
# ---------------------------------------------------------------------------

# -- application ------------------------------------------------------------
DECKFORGE_ENVIRONMENT=local
DECKFORGE_LOG_LEVEL=INFO
DECKFORGE_LOG_FORMAT=console            # console | json
DECKFORGE_CORS_ORIGINS=http://localhost:3000

# -- storage ----------------------------------------------------------------
# Leave both unset and DeckForge picks the right place on its own: `./data` in a
# source checkout, and the per-user application data folder in a desktop
# install. Set them only to override.
# DECKFORGE_DATA_DIR=./data
# DECKFORGE_DATABASE_URL=postgresql+asyncpg://deckforge:deckforge@localhost:5432/deckforge
# DECKFORGE_REDIS_URL=redis://localhost:6379/0

# -- default model ----------------------------------------------------------
DECKFORGE_DEFAULT_PROVIDER=ollama
DECKFORGE_DEFAULT_MODEL=qwen3:8b
DECKFORGE_DEFAULT_TEMPERATURE=0.7
DECKFORGE_MAX_OUTPUT_TOKENS=8192
DECKFORGE_REQUEST_TIMEOUT_SECONDS=300

# -- local providers --------------------------------------------------------
DECKFORGE_OLLAMA_BASE_URL=http://localhost:11434
DECKFORGE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
DECKFORGE_LLAMACPP_BASE_URL=http://localhost:8080/v1
DECKFORGE_VLLM_BASE_URL=http://localhost:8000/v1

# -- cloud providers (all optional) -----------------------------------------
# DECKFORGE_OPENAI_API_KEY=
# DECKFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
# DECKFORGE_ANTHROPIC_API_KEY=
# DECKFORGE_OPENROUTER_API_KEY=
# DECKFORGE_GEMINI_API_KEY=
# DECKFORGE_GROQ_API_KEY=
# DECKFORGE_TOGETHER_API_KEY=
# DECKFORGE_DEEPSEEK_API_KEY=
# DECKFORGE_MISTRAL_API_KEY=
# DECKFORGE_AZURE_OPENAI_API_KEY=
# DECKFORGE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# DECKFORGE_AZURE_OPENAI_API_VERSION=2024-10-21

# -- engine tuning ----------------------------------------------------------
# Extra theme packages and plugins (comma separated paths).
# DECKFORGE_THEME_PATHS=./my-themes
# DECKFORGE_PLUGIN_PATHS=./plugins
DECKFORGE_MAX_UPLOAD_BYTES=52428800
DECKFORGE_RETRIEVAL_TOP_K=8
DECKFORGE_MAX_SLIDES=60
DECKFORGE_WORKER_CONCURRENCY=4
DECKFORGE_ENABLE_CRITIC=true
DECKFORGE_ENABLE_FACT_CHECKER=true
# How much prose each slide carries: concise | balanced | rich.
# `rich` writes explanatory paragraphs so a deck reads without a presenter.
# The composer's Detail control and an explicit request both override this.
DECKFORGE_CONTENT_DENSITY=rich
