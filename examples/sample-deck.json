          "hidden": false,
          "z": 0,
          "type": "code",
          "language": "python",
          "source": "import gymnasium as gym\n\nenv = gym.make('CartPole-v1')\nstate, _ = env.reset(seed=0)\nfor _ in range(500):\n    action = policy(state)\n    state, reward, done, truncated, _ = env.step(action)\n    if done or truncated:\n        state, _ = env.reset()",
          "caption": null,
          "highlight_lines": []
        },
        {
          "id": "el_8f4c3e12d9",
          "slot": "body",
          "frame": null,
          "style": {},
          "hidden": false,
          "z": 0,
          "type": "text",
          "text": "Instrument the reward before you tune anything else.",
          "role": "lead",
          "align": "start",
          "markdown": true
        }
      ],
      "notes": "Give them a concrete first commit. Momentum beats theory.",
