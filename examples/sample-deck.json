      "section_id": "sec_6acb2b6741",
      "eyebrow": null,
      "title": "The core loop",
      "subtitle": "An agent learns by acting, not by being told",
      "elements": [
        {
          "id": "el_43960aaa4c",
          "slot": "body",
          "frame": null,
          "style": {},
          "hidden": false,
          "z": 0,
          "type": "bullets",
          "items": [
            {
              "text": "The **agent** observes a state",
              "level": 0,
              "icon": null,
              "emphasis": false
            },
            {
              "text": "It selects an **action** from a policy",
              "level": 0,
              "icon": null,
              "emphasis": false
            },
            {
              "text": "The environment returns a **reward** and the next state",
              "level": 0,
              "icon": null,
              "emphasis": false
            },
            {
              "text": "The policy updates so good actions become more likely",
              "level": 0,
              "icon": null,
              "emphasis": false
            }
          ],
          "bullet_style": "dot"
        },
        {
          "id": "el_173a2c8cf2",
          "slot": "body",
          "frame": null,
          "style": {},
          "hidden": false,
          "z": 0,
          "type": "diagram",
          "engine": "mermaid",
          "source": "flowchart LR\n  A[Agent] -- action --> E[Environment]\n  E -- state, reward --> A",
          "caption": "The agent-environment loop",
          "rendered_asset_id": null
        }
      ],
      "notes": "Stress that the reward is the only supervision. Everything downstream inherits its flaws.",
      "background": null,
      "theme_overrides": {},
      "animations": [],
      "references": [],
      "metadata": {},
      "locked": false,
      "hidden": false
    },
